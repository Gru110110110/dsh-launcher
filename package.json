{
  "name": "dsh-launcher",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/*.mjs\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"scripts/*.mjs\" \"*.{json,ts}\"",
    "deadcode": "knip",
    "bindings": "cargo run --quiet -p dsh-core --example export_bindings -- src/platform/generated/bindings.ts && prettier --write src/platform/generated/bindings.ts",
    "versions": "node scripts/check-versions.mjs",
    "cloudflare:check": "node scripts/check-cloudflare.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@tauri-apps/api": "2.8.0",
    "i18next": "25.5.2",
    "lottie-web": "5.13.0",
    "lucide-react": "0.542.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "16.0.0",
    "react-router-dom": "7.9.1",
    "sonner": "2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@tauri-apps/cli": "2.8.4",
    "@types/node": "24.5.2",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.0.3",
    "eslint": "9.36.0",
    "eslint-plugin-boundaries": "5.0.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.4.0",
    "knip": "5.64.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  },
  "knip": {
    "entry": [
      "src/main.tsx"
    ],
    "project": [
      "src/**/*.{ts,tsx}"
    ],
    "ignore": [
      "public/**",
      "target/**",
      "src/platform/generated/**"
    ]
  }
}
